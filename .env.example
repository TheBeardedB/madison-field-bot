# Copy this to .env and fill in your values

DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here

# Optional: override the default Madison field status RSS feed URL
RSS_FEED_URL=https://www.madisonal.gov/RSSFeed.aspx?ModID=1&CID=Field-Status-6

# Optional: change how often the bot checks the feed
POLL_INTERVAL_MINUTES=2

# Required for Railway/Postgres persistence
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_database

# Optional: customize the feed identifier if you want to run multiple feeds later
# FEED_ID=madison-field-status
