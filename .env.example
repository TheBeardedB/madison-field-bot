# Copy this to .env and fill in your values

DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here

# Optional: override the default Madison field status RSS feed URL
# RSS_FEED_URL=https://www.madisonal.gov/RSSFeed.aspx?ModID=1&CID=Field-Status-6

# Optional: GitHub Models-assisted parsing for partial field closures
# When enabled, the parser keeps deterministic open/closed logic and asks
# a GitHub AI model to extract only closed fields for partial-style updates.
LLM_PARTIAL_PARSE_ENABLED=false
GITHUB_MODELS_TOKEN=your_github_models_or_pat_token_here
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
LLM_MODEL=openai/gpt-4.1-mini
LLM_PARTIAL_MIN_CONFIDENCE=0.65
LLM_PARTIAL_PARSE_TIMEOUT_SECONDS=12
